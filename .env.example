# .env.example — committed template. NEVER put real values here.
#
# ADR-0015: .env is DEVELOPER-LOCAL ONLY. It is not a production mechanism.
# Config references these by typed URI (secret://env/NAME), never by ${interpolation}.
# Resolved values are wrapped in SecretStr and redact in logs.

# Fine-grained PAT, scoped to the L.I.O.N.E.L repo only:
#   contents: read/write · metadata: read · pull_requests: write
# Nothing else. No org-wide access.
GITHUB_PAT=

# Required only at tier L3. Unset at L0/L1/L2-local.
ANTHROPIC_API_KEY=

# Local services
QDRANT_URL=http://localhost:6333
OLLAMA_HOST=http://localhost:11434

# Active tier: l0 | l1 | l2 | l3   (ADR-0007)
LIONEL_TIER=l0
